{
  "installCommand": "npm install && npm ci --prefix mobile",
  "buildCommand": "npm test && npm run test:mobile && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mobile/:path*",
      "destination": "/mobile"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
